# Acceptance: "Spin a project up/down locally in different environments".
# One uv app declares two environments; the active one is switched with
# `upc env use`, and the app is brought up and down under each. upc reports names
# and paths only, never values.
[!exec:uv] skip 'uv is not on PATH'

exec upc new app demo --language python --pm uv --yes
cd demo
exec upc install
mkdir config
cp ../dev.env config/dev.env
cp ../staging.env config/staging.env
cp ../env.toml .universal-package-core/config.toml
grep 'project_type = ' .universal-package-core/config.toml

exec upc env list
stdout 'dev +config/dev.env'
stdout 'staging +config/staging.env'
! stdout 'hunter2'

exec upc env use dev
exec upc env show
stdout 'dev \(config/dev.env\)'
exec upc up 8123
stdout 'started "dev"'
exists .universal-package-core/run/up.pid
exec sleep 2
exec upc down
stdout 'stopped'
! exists .universal-package-core/run/up.pid

exec upc env use staging
exec upc env show
stdout 'staging \(config/staging.env\)'
! stdout 'dev \('
grep 'active_environment = .staging.' .universal-package-core/config.toml
exec upc up 8124
stdout 'started "dev"'
exists .universal-package-core/run/up.pid
exec sleep 2
exec upc down
stdout 'stopped'
! exists .universal-package-core/run/up.pid

# an unknown environment changes nothing
! exec upc env use nope
stderr 'does not exist'
grep 'active_environment = .staging.' .universal-package-core/config.toml
exec upc doctor

# env add and env remove edit the project config; values are never printed
exec upc env add qa --file config/qa.env --groups test,docs
stdout 'declared environment qa'
grep 'groups = ' .universal-package-core/config.toml
! exec upc env add qa
stderr 'already declared'
! exec upc env add 'bad name'
exec upc env list
stdout 'qa +config/qa.env.*groups=test,docs'
stdout '\(file missing\)'
! stdout 'hunter2'
cp ../dev.env config/qa.env
exec upc env show
stdout 'staging \(config/staging.env\)'

# --env applies to one command and does not change the saved selection
exec upc install --env staging
exec upc up --env dev 8123
stdout 'started "dev"'
exec sleep 2
exec upc down
stdout 'stopped'
grep 'active_environment = .staging.' .universal-package-core/config.toml
! exec upc install --env nope
stderr 'does not exist'
! exec upc up --env nope 8124
stderr 'does not exist'
! exists .universal-package-core/run/up.pid

exec upc env remove qa
stdout 'removed environment qa'
! grep 'environments.qa' .universal-package-core/config.toml
exists config/qa.env
! exec upc env remove qa
stderr 'not declared'
-- dev.env --
TOKEN=hunter2
-- staging.env --
TOKEN=hunter2
-- env.toml --
project_type = "app"
default_environment = "dev"

[environments.dev]
file = "config/dev.env"

[environments.staging]
file = "config/staging.env"
