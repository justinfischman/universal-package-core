# up -> down -> publish (dry-run and refusal) with the real uv.
# A real publish never runs here.
cd app

exec upc up
stdout 'started "dev"'
exists .universal-package-core/run/up.pid
exec sleep 6
grep 'serving' .universal-package-core/run/up.log

exec upc down
stdout 'stopped'
! exists .universal-package-core/run/up.pid

exec upc --dry-run publish
stdout 'uv build'
stdout 'uv publish'

! exec upc publish
stderr 'needs confirmation'

-- app/pyproject.toml --
[project]
name = "demo"
version = "0.1.0"
requires-python = ">=3.9"

[project.scripts]
dev = "demo:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
-- app/demo/__init__.py --
import time

def main():
    print("serving", flush=True)
    time.sleep(300)
