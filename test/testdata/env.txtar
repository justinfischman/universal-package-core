# env list/use/show work from the project config and .env.* files; values are never printed
cd project
exec upc env list
stdout '\* dev +config/dev.env \[config\]'
stdout '  local +\.env\.local \[convention\]'
! stdout 'hunter2'
! stdout 'example'

exec upc env show
stdout 'dev \(config/dev.env\) \[config\]'

exec upc env use local
stdout 'active environment: local'
grep 'active_environment = .local.' .universal-package-core/config.toml
exec upc env show
stdout 'local \(\.env\.local\) \[convention\]'

# an unknown environment is a usage error and changes nothing
! exec upc env use nope
stderr 'does not exist'
grep 'active_environment = .local.' .universal-package-core/config.toml

# a declared environment whose file is missing is refused too
! exec upc env use staging
stderr 'staging.*does not exist'

# a vanished active environment is reported
rm .env.local
! exec upc env show
stderr 'active environment "local" does not exist'

-- project/.universal-package-core/config.toml --
default_environment = "dev"

[environments.dev]
file = "config/dev.env"

[environments.staging]
file = "config/staging.env"
-- project/config/dev.env --
TOKEN=hunter2
-- project/.env.local --
TOKEN=hunter2
-- project/.env.example --
TOKEN=
